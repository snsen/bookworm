{
  "name": "bookworm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "fixtures": "node scripts/fetch-fixtures.mjs",
    "e2e": "npm run build && node tests/e2e/run.mjs",
    "soak": "node tests/e2e/soak.mjs"
  },
  "dependencies": {
    "@gullabs/flipbook-core": "^3.2.2",
    "dompurify": "^3.5.0",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "description": "Projektör için otomatik sayfa çeviren kitap gösterici (PDF/EPUB), tamamen tarayıcıda çalışır.",
  "engines": {
    "node": ">=20"
  }
}
